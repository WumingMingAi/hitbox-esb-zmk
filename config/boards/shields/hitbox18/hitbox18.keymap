/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp W    &kp A    &kp S    &kp D    &kp UP   &kp SPACE
                &kp I    &kp J    &kp K    &kp L    &kp LEFT &kp ENTER
                &kp Q    &kp E    &kp R    &kp F    &kp DOWN &kp ESC
            >;
        };
    };
};

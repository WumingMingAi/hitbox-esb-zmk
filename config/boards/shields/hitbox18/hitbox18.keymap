/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
    &kp W    &kp A    &kp S    &kp D    &kp UP_ARROW   &kp SPACE
    &kp I    &kp J    &kp K    &kp L    &kp LEFT_ARROW &kp ENTER
    &kp Q    &kp E    &kp R    &kp F    &kp DOWN_ARROW &kp ESCAPE
            >;
        };
    };
};
